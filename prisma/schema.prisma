// Globify Tech — PostgreSQL schema
// See docs/DATABASE.md for the domain map and conventions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum RoleKey {
  SUPER_ADMIN
  ADMIN
  ACADEMIC_MANAGER
  ADMISSIONS_MANAGER
  FINANCE_MANAGER
  CONTENT_MANAGER
  MARKETING_MANAGER
  CAREER_MANAGER
  INSTRUCTOR
  TEACHING_ASSISTANT
  COUNSELLOR
  STUDENT
  ALUMNI
  EMPLOYER
  GUEST
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LearningMode {
  ON_CAMPUS
  LIVE_ONLINE
  HYBRID
  SELF_PACED
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  TEXT
  LIVE
  QUIZ
  ASSIGNMENT
  PROJECT
  RESOURCE
}

enum ResourceType {
  FILE
  LINK
  VIDEO
  CODE
}

enum EnrollmentSource {
  ADMISSION
  DIRECT
  SCHOLARSHIP
  MANUAL
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  PAUSED
  DROPPED
  EXPIRED
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTIPLE_SELECT
  TRUE_FALSE
  SHORT_ANSWER
  LONG_ANSWER
  FILL_BLANK
  MATCHING
  ORDERING
  IMAGE
  CODE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
  EXPIRED
}

enum SubmissionKind {
  TEXT
  FILE
  URL
  GITHUB
  WEBSITE
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUESTED
  APPROVED
  REJECTED
}

enum BatchStatus {
  PLANNED
  OPEN
  RUNNING
  COMPLETED
  CANCELLED
}

enum LiveClassStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum LiveProvider {
  ZOOM
  GOOGLE_MEET
  MICROSOFT_TEAMS
  MANUAL
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AttendanceMethod {
  MANUAL
  QR
  STUDENT_PORTAL
  INSTRUCTOR_PORTAL
}

enum LeadSource {
  WEBSITE
  FACEBOOK
  INSTAGRAM
  GOOGLE
  WHATSAPP
  REFERRAL
  WALK_IN
  PHONE
  EVENT
  ORGANIC
}

enum LeadStage {
  NEW
  CONTACTED
  COUNSELLING
  INTERESTED
  APPLICATION
  APPROVED
  FEE_PENDING
  ENROLLED
  LOST
}

enum LeadActivityType {
  CALL
  WHATSAPP
  EMAIL
  MEETING
  NOTE
  STAGE_CHANGE
  TASK
  SYSTEM
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WAITLISTED
  ENROLLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  JAZZCASH
  EASYPAISA
  BANK_TRANSFER
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum CertificateStatus {
  VALID
  REVOKED
  EXPIRED
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
  REMOTE
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
}

enum JobApplicationStatus {
  APPLIED
  SHORTLISTED
  INTERVIEW
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
}

enum PageSectionType {
  HERO
  TEXT
  IMAGE
  VIDEO
  COURSE_GRID
  PROGRAM_GRID
  INSTRUCTOR_GRID
  STATS
  TESTIMONIALS
  FAQ
  CTA
  BLOG
  GALLERY
  TIMELINE
  LOGO_CLOUD
  FEATURES
  LEARNING_PATHS
  EVENTS
  SUCCESS_STORIES
}

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  OTHER
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  SMS
  PUSH
}

enum NotificationEvent {
  WELCOME
  EMAIL_VERIFICATION
  PASSWORD_RESET
  ENROLLMENT
  PAYMENT_RECEIVED
  PAYMENT_DUE
  CLASS_REMINDER
  ASSIGNMENT_DEADLINE
  QUIZ_AVAILABLE
  EXAM_SCHEDULED
  CERTIFICATE_ISSUED
  ATTENDANCE_WARNING
  ANNOUNCEMENT
  MESSAGE
  APPLICATION_STATUS
  LEAD_ASSIGNED
  RISK_ALERT
  BACKUP_ALERT
  SYSTEM
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  READ
}

enum AIRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

enum AIContextType {
  TUTOR
  COURSE_BUILDER
  ADMIN_ASSISTANT
  SUCCESS_ENGINE
  GENERAL
}

enum AIGenerationStatus {
  DRAFT
  APPROVED
  REJECTED
  APPLIED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ExamKind {
  MIDTERM
  FINAL
  PRACTICAL
  MOCK
}

// ─────────────────────────────────────────────────────────────
// IDENTITY & ACCESS
// ─────────────────────────────────────────────────────────────

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  emailVerifiedAt DateTime?
  passwordHash    String?
  name            String
  firstName       String?
  lastName        String?
  avatarMediaId   String?    @db.Uuid
  phone           String?
  whatsapp        String?
  locale          String     @default("en")
  timezone        String     @default("Asia/Karachi")
  status          UserStatus @default(ACTIVE)
  sessionVersion  Int        @default(1)
  failedLogins    Int        @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  isTestData      Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  avatar                     Media?                    @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  accounts                   Account[]
  sessions                   Session[]
  roles                      UserRole[]
  studentProfile             StudentProfile?
  instructorProfile          InstructorProfile?
  staffProfile               StaffProfile?
  employerProfile            EmployerProfile?
  notifications              Notification[]
  auditLogs                  AuditLog[]                @relation("AuditActor")
  aiConversations            AIConversation[]
  conversations              ConversationParticipant[]
  messagesSent               Message[]                 @relation("MessageSender")
  discussions                Discussion[]
  discussionReplies          DiscussionReply[]
  reactions                  Reaction[]
  groupMemberships           GroupMember[]
  badges                     UserBadge[]
  streak                     Streak?
  leadsAssigned              Lead[]                    @relation("LeadCounsellor")
  leadsConverted             Lead[]                    @relation("LeadConvertedUser")
  leadActivities             LeadActivity[]
  leadTasks                  LeadTask[]                @relation("LeadTaskAssignee")
  leadNotes                  LeadNote[]
  applications               Application[]             @relation("ApplicantUser")
  applicationsReviewed       Application[]             @relation("ApplicationReviewer")
  blogPosts                  BlogPost[]
  mediaUploads               Media[]                   @relation("MediaUploader")
  coursesCreated             Course[]                  @relation("CourseCreator")
  pagesCreated               Page[]
  settingsUpdated            Setting[]
  certificatesSigned         Certificate[]             @relation("CertificateSigner")
  attendanceMarked           Attendance[]              @relation("AttendanceMarker")
  announcements              Announcement[]
  eventRegistrations         EventRegistration[]
  reportsFiled               Report[]                  @relation("ReportReporter")
  aiGenerations              AIGeneration[]            @relation("AIGenerationRequester")
  aiGenerationsApproved      AIGeneration[]            @relation("AIGenerationApprover")
  submissionsReviewed        AssignmentSubmission[]    @relation("SubmissionReviewer")
  projectSubmissionsReviewed ProjectSubmission[]       @relation("ProjectSubmissionReviewer")
  paymentsRecorded           Payment[]                 @relation("PaymentRecorder")
  refundsProcessed           Refund[]                  @relation("RefundProcessor")
  invoicesIssued             Invoice[]                 @relation("InvoiceIssuer")
  liveClassesHosted          LiveClass[]               @relation("LiveClassHost")
  verificationTokens         VerificationToken[]

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

// Auth.js
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  identifier String
  tokenHash  String    @unique
  purpose    String // EMAIL_VERIFY | PASSWORD_RESET | INVITE | MAGIC_LINK
  userId     String?   @db.Uuid
  expires    DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier, purpose])
  @@map("verification_tokens")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         RoleKey  @unique
  name        String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique // e.g. courses.publish
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  campusId   String?  @db.Uuid
  assignedAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  campus Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model StudentProfile {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @db.Uuid
  studentNumber     String    @unique
  dateOfBirth       DateTime?
  gender            String?
  city              String?
  country           String    @default("PK")
  address           String?
  education         String?
  guardianName      String?
  guardianPhone     String?
  bio               String?
  headline          String?
  githubUrl         String?
  linkedinUrl       String?
  websiteUrl        String?
  cvMediaId         String?   @db.Uuid
  freelanceProfiles Json?
  campusId          String?   @db.Uuid
  isTestData        Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus             Campus?                @relation(fields: [campusId], references: [id], onDelete: SetNull)
  cv                 Media?                 @relation("StudentCv", fields: [cvMediaId], references: [id], onDelete: SetNull)
  enrollments        Enrollment[]
  batches            BatchStudent[]
  attendance         Attendance[]
  quizAttempts       QuizAttempt[]
  examAttempts       ExamAttempt[]
  submissions        AssignmentSubmission[]
  projectSubmissions ProjectSubmission[]
  invoices           Invoice[]
  certificates       Certificate[]
  portfolio          Portfolio?
  skills             StudentSkill[]
  jobApplications    JobApplication[]
  riskScores         StudentRiskScore[]
  scholarshipAwards  ScholarshipAward[]
  reviews            Review[]
  liveAttendance     LiveClassAttendance[]
  lessonNotes        LessonNote[]
  bookmarks          LessonBookmark[]

  @@index([campusId])
  @@map("students")
}

model InstructorProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  slug            String   @unique
  title           String? // e.g. "Senior Performance Marketer"
  bio             String?
  expertise       String[]
  yearsExperience Int?
  linkedinUrl     String?
  websiteUrl      String?
  isFeatured      Boolean  @default(false)
  isPublic        Boolean  @default(true)
  campusId        String?  @db.Uuid
  isTestData      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus  Campus?            @relation(fields: [campusId], references: [id], onDelete: SetNull)
  courses InstructorCourse[]
  batches Batch[]

  @@index([campusId])
  @@map("instructors")
}

model StaffProfile {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  employeeId String   @unique
  jobTitle   String?
  department String?
  campusId   String?  @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@index([campusId])
  @@map("staff")
}

// ─────────────────────────────────────────────────────────────
// CAMPUS
// ─────────────────────────────────────────────────────────────

model Campus {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  address   String?
  city      String
  country   String   @default("PK")
  phone     String?
  email     String?
  timezone  String   @default("Asia/Karachi")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classrooms  Classroom[]
  batches     Batch[]
  students    StudentProfile[]
  instructors InstructorProfile[]
  staff       StaffProfile[]
  userRoles   UserRole[]
  courses     Course[]
  events      Event[]

  @@map("campuses")
}

model Classroom {
  id        String   @id @default(uuid()) @db.Uuid
  campusId  String   @db.Uuid
  name      String
  capacity  Int      @default(18)
  floor     String?
  equipment String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campus  Campus  @relation(fields: [campusId], references: [id], onDelete: Cascade)
  batches Batch[]

  @@unique([campusId, name])
  @@map("classrooms")
}

// ─────────────────────────────────────────────────────────────
// CATALOG
// ─────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  artworkKey  String   @default("ai") // visual identity key for artwork system
  order       Int      @default(0)
  parentId    String?  @db.Uuid
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  courses  Course[]

  @@map("categories")
}

model Skill {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  courses  CourseSkill[]
  students StudentSkill[]
  jobs     JobSkill[]

  @@map("skills")
}

model Course {
  id                 String        @id @default(uuid()) @db.Uuid
  slug               String        @unique
  title              String
  subtitle           String?
  description        String? // sanitized HTML
  shortDescription   String?
  categoryId         String?       @db.Uuid
  level              CourseLevel   @default(BEGINNER)
  mode               LearningMode  @default(HYBRID)
  durationWeeks      Int?
  hoursPerWeek       Int?
  language           String        @default("en")
  price              Decimal       @default(0) @db.Decimal(12, 2)
  discountPrice      Decimal?      @db.Decimal(12, 2)
  currency           String        @default("PKR")
  artworkMediaId     String?       @db.Uuid
  promoVideoMediaId  String?       @db.Uuid
  status             ContentStatus @default(DRAFT)
  publishedAt        DateTime?
  featured           Boolean       @default(false)
  outcomes           String[]
  prerequisites      String[]
  careerOutcomes     String[]
  faqs               Json? // [{question, answer}]
  seoTitle           String?
  seoDescription     String?
  ogImageMediaId     String?       @db.Uuid
  noindex            Boolean       @default(false)
  ratingAvg          Decimal       @default(0) @db.Decimal(3, 2)
  ratingCount        Int           @default(0)
  studentCount       Int           @default(0)
  leaderboardEnabled Boolean       @default(false)
  campusId           String?       @db.Uuid
  createdById        String?       @db.Uuid
  isTestData         Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  category        Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  artwork         Media?                 @relation("CourseArtwork", fields: [artworkMediaId], references: [id], onDelete: SetNull)
  promoVideo      Media?                 @relation("CoursePromo", fields: [promoVideoMediaId], references: [id], onDelete: SetNull)
  ogImage         Media?                 @relation("CourseOg", fields: [ogImageMediaId], references: [id], onDelete: SetNull)
  campus          Campus?                @relation(fields: [campusId], references: [id], onDelete: SetNull)
  createdBy       User?                  @relation("CourseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  skills          CourseSkill[]
  instructors     InstructorCourse[]
  modules         CourseModule[]
  quizzes         Quiz[]
  assignments     Assignment[]
  projects        Project[]
  exams           Exam[]
  completionRules CourseCompletionRule[]
  enrollments     Enrollment[]
  batches         Batch[]
  reviews         Review[]
  programs        ProgramCourse[]
  pathSteps       LearningPathStep[]
  feePlans        FeePlan[]
  leads           Lead[]
  applications    Application[]
  certificates    Certificate[]
  discussions     Discussion[]
  announcements   Announcement[]
  aiGenerations   AIGeneration[]
  liveClasses     LiveClass[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([featured])
  @@map("courses")
}

model CourseSkill {
  courseId String @db.Uuid
  skillId  String @db.Uuid

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([courseId, skillId])
  @@map("course_skills")
}

model InstructorCourse {
  instructorId String  @db.Uuid
  courseId     String  @db.Uuid
  isLead       Boolean @default(false)

  instructor InstructorProfile @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  course     Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([instructorId, courseId])
  @@map("instructor_courses")
}

model CourseModule {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @db.Uuid
  title       String
  description String?
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  units  CourseUnit[]

  @@index([courseId, order])
  @@map("course_modules")
}

model CourseUnit {
  id        String   @id @default(uuid()) @db.Uuid
  moduleId  String   @db.Uuid
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module  CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([moduleId, order])
  @@map("course_units")
}

model Lesson {
  id              String     @id @default(uuid()) @db.Uuid
  unitId          String     @db.Uuid
  title           String
  slug            String
  type            LessonType @default(VIDEO)
  content         String? // sanitized HTML for TEXT lessons / description
  videoMediaId    String?    @db.Uuid
  videoUrl        String? // external (e.g. Vimeo/YouTube) when not stored
  durationSeconds Int        @default(0)
  order           Int        @default(0)
  isPreview       Boolean    @default(false)
  isPublished     Boolean    @default(true)
  objectives      String[]
  quizId          String?    @unique @db.Uuid
  assignmentId    String?    @unique @db.Uuid
  projectId       String?    @unique @db.Uuid
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  unit          CourseUnit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  video         Media?           @relation("LessonVideo", fields: [videoMediaId], references: [id], onDelete: SetNull)
  quiz          Quiz?            @relation(fields: [quizId], references: [id], onDelete: SetNull)
  assignment    Assignment?      @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  project       Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  resources     LessonResource[]
  progress      LessonProgress[]
  videoProgress VideoProgress[]
  notes         LessonNote[]
  bookmarks     LessonBookmark[]
  discussions   Discussion[]
  liveClasses   LiveClass[]

  @@unique([unitId, slug])
  @@index([unitId, order])
  @@map("lessons")
}

model LessonResource {
  id        String       @id @default(uuid()) @db.Uuid
  lessonId  String       @db.Uuid
  title     String
  type      ResourceType @default(FILE)
  mediaId   String?      @db.Uuid
  url       String?
  order     Int          @default(0)
  createdAt DateTime     @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  media  Media? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([lessonId])
  @@map("lesson_resources")
}

model Program {
  id             String        @id @default(uuid()) @db.Uuid
  slug           String        @unique
  title          String
  subtitle       String?
  description    String?
  artworkMediaId String?       @db.Uuid
  durationWeeks  Int?
  price          Decimal?      @db.Decimal(12, 2)
  currency       String        @default("PKR")
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  featured       Boolean       @default(false)
  outcomes       String[]
  seoTitle       String?
  seoDescription String?
  isTestData     Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  artwork Media?          @relation("ProgramArtwork", fields: [artworkMediaId], references: [id], onDelete: SetNull)
  courses ProgramCourse[]

  @@map("programs")
}

model ProgramCourse {
  programId String @db.Uuid
  courseId  String @db.Uuid
  order     Int    @default(0)

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([programId, courseId])
  @@map("program_courses")
}

model LearningPath {
